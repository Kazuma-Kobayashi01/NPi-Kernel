#!/bin/sh
# PID 1 of the sandbox VM (kernel argument rdinit=/sbin/npi-init): bring the guest up and hand over to the
# command agent. The root filesystem is the initramfs, so nothing persists across boots.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /run /tmp /root
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
echo npi-vm > /proc/sys/kernel/hostname

for module in fuse virtiofs virtio_net; do modprobe "$module" 2>/dev/null; done

ip link set lo up
if grep -q 'npi.net=nat' /proc/cmdline; then
	ip link set eth0 up 2>/dev/null
	# One lease or give up: the agent must not wait on a network that is not there.
	# Alpine's busybox keeps the lease script under /usr/share, Ubuntu's udhcpc package under /etc.
	script=/usr/share/udhcpc/default.script
	[ -f "$script" ] || script=/etc/udhcpc/default.script
	timeout 8 udhcpc -i eth0 -n -q -s "$script" >/dev/null 2>&1
fi

export HOME=/root LANG=C.UTF-8
# tini reaps what the agent's commands leave behind and forwards signals.
tini=$(command -v tini || echo /sbin/tini)
exec "$tini" -- /usr/bin/python3 /usr/lib/npi/agent.py
