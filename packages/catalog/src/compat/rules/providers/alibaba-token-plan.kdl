// Provider-wire compat for "alibaba-token-plan"; regenerated from the frozen census using deployment contract selectors.

provider "alibaba-token-plan" {
	default-model "qwen3.7-plus"
	env "ALIBABA_TOKEN_PLAN_API_KEY" "BAILIAN_TOKEN_PLAN_API_KEY"
	dynamic-models-authoritative #true
	discovery label="QwenCloud Token Plan"

	// QwenCloud Token Plan's documented Individual text-model allowlist, bundled
	// when credentialed discovery is unavailable. A successful `/models` response
	// is authoritative for the subscribed edition and must not be widened by this
	// seed; when it is bundled it outranks same-id rows so incomplete upstream
	// metadata cannot replace its capabilities.
	seed api="openai-completions" base-url="https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1" bundle="fallback" precedence="seed" {
		model "qwen3.8-max-preview" name="Qwen3.8 Max Preview" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=983616 max-tokens=131072
			thinking-mode "effort"
			thinking-efforts "low" "high" "xhigh"
			thinking-requires-effort #true
			supports-developer-role #false
			supports-reasoning-effort #true
		}
		model "deepseek-v3.2" name="DeepSeek V3.2" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072 max-tokens=65536
		}
		model "deepseek-v4-flash" name="DeepSeek V4 Flash" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4-flash-0731" name="DeepSeek V4 Flash 0731" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4-pro" name="DeepSeek V4 Pro" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4-pro-0813" name="DeepSeek V4 Pro 0813" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4.1-flash" name="DeepSeek V4.1 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4.1-flash-1017" name="DeepSeek V4.1 Flash 1017" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "glm-5" name="GLM-5" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=202752 max-tokens=16384
		}
		model "glm-5.1" name="GLM-5.1" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=202752 max-tokens=128000
		}
		model "glm-5.2" name="GLM-5.2" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "glm-5.3" name="GLM-5.3" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "kimi-k2.5" name="Kimi K2.5" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=98304
		}
		model "kimi-k2.6" name="Kimi K2.6" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=262144
		}
		model "kimi-k2.7-code" name="Kimi K2.7 Code" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=262144
		}
		model "MiniMax-M2.5" name="MiniMax-M2.5" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=196608 max-tokens=32768
		}
		model "qwen3.6-flash" name="Qwen3.6 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=65536
		}
		model "qwen3.6-plus" name="Qwen3.6 Plus" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=65536
		}
		model "qwen3.7-max" name="Qwen3.7 Max" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "qwen3.7-plus" name="Qwen3.7 Plus" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=65536
		}
		model "qwen3.8-flash" name="Qwen3.8 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "qwen3.8-max" name="Qwen3.8 Max" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
	}

	// Replaces the Alibaba-compatible thinking-format branch.
	thinking-format "qwen"
	thinking-mode "effort"
	class "qwen" {
		revision ">=3.6 <3.8" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
		revision ">=3.8 <3.9" {
			supports-reasoning-effort #true
		}
	}
	// Max Preview rides only Alibaba's binary enable_thinking toggle: it stays on
	// the Qwen dialect and must not emit an unsupported reasoning_effort field.
	models "qwen3.8-max" {
		thinking-default-level "xhigh"
	}
	models "qwen3.8-max-preview" {
		thinking-efforts "low" "high" "xhigh"
		thinking-requires-effort #true
	}

	// Thinking support follows models.dev as shipped in OpenCode 2.2.5: a binary switch shows one
	// level, effort models send reasoning_effort with enable_thinking, and always-on models with no
	// control (reasoning #false in the seed) send no thinking parameter.
	models "deepseek-v3.2" "glm-5" "glm-5.1" "kimi-k2.5" "kimi-k2.6" "kimi-k2.7-code" "qwen3.6-flash" "qwen3.6-plus" "qwen3.7-max" "qwen3.7-plus" {
		thinking-upgrade-neutral #true
		thinking-efforts "medium"
		thinking-requires-effort #false
		thinking-format "qwen"
	}
	models "deepseek-v4-flash" "deepseek-v4-flash-0731" "deepseek-v4-pro" "deepseek-v4-pro-0813" {
		thinking-upgrade-neutral #true
		thinking-efforts "high" "max"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "deepseek-v4.1-flash" "deepseek-v4.1-flash-1017" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "glm-5.2" {
		thinking-upgrade-neutral #true
		thinking-efforts "high" "max"
		thinking-requires-effort #true
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "glm-5.3" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-requires-effort #true
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "qwen3.8-flash" "qwen3.8-max" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "medium" "xhigh"
		thinking-format "qwen"
		supports-reasoning-effort #true
		replay-reasoning-content #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
}
