	// A binary enable_thinking switch shows one level; effort models send
	// reasoning_effort with enable_thinking. Models that always think and take no control
	// (reasoning #false in the seed) send no thinking parameter at all.
	models "deepseek-v4-flash-0731" "deepseek-v4-pro-0813" "deepseek-v4.1-flash" "deepseek-v4.1-flash-1017" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-default-level "high"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "deepseek-v4-pro" "glm-5.2" {
		thinking-upgrade-neutral #true
		thinking-efforts "high" "max"
		thinking-default-level "high"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "glm-5.1" "qwen-flash" "qwen-plus" "qwen-turbo" "qwen3-14b" "qwen3-235b-a22b" "qwen3-32b" "qwen3-8b" "qwen3-omni-flash" "qwen3-vl-30b-a3b" "qwen3-vl-plus" "qwen3.5-122b-a10b" "qwen3.5-27b" "qwen3.5-35b-a3b" "qwen3.5-397b-a17b" "qwen3.5-flash" "qwen3.5-plus" "qwen3.6-27b" "qwen3.6-35b-a3b" "qwen3.6-flash" "qwen3.6-max-preview" "qwen3.6-plus" "qwen3.7-flash" "qwen3.7-max" "qwen3.7-plus" {
		thinking-upgrade-neutral #true
		thinking-efforts "medium"
		thinking-requires-effort #false
		thinking-format "qwen"
	}
	models "glm-5.3" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-default-level "max"
		thinking-requires-effort #true
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "kimi-k2.7-code" "qwen3-next-80b-a3b-thinking" "qwen3-vl-235b-a22b" {
		thinking-upgrade-neutral #true
		thinking-efforts "medium"
		thinking-requires-effort #true
		thinking-format "qwen"
	}
	models "kimi-k3" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-default-level "max"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
