// Catalog entry for "alibaba" (Alibaba Cloud Model Studio international, pay-as-you-go; keys are region-locked, so it has its own env var).
// Model metadata and thinking support follow models.dev as shipped in OpenCode 2.2.5.
// The seed supplies names, limits, prices and image input for discovered ids;
// the `models` blocks declare which thinking control each id really has.

provider "alibaba" {
	default-model "qwen-plus"
	env "DASHSCOPE_INTL_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Alibaba"

	seed api="openai-completions" base-url="https://dashscope-intl.aliyuncs.com/compatible-mode/v1" bundle="fallback" {
		model "deepseek-v4-flash-0731" name="DeepSeek V4 Flash 0731" {
			reasoning #true
			input "text"
			cost input=0.44 output=1.32 cache-read=0.088 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4-pro" name="DeepSeek V4 Pro" {
			reasoning #true
			input "text"
			cost input=2.4 output=4.8 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4-pro-0813" name="DeepSeek V4 Pro 0813" {
			reasoning #true
			input "text"
			cost input=1.32 output=3.96 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4.1-flash" name="DeepSeek V4.1 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0.3 output=1.2 cache-read=0.03 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "deepseek-v4.1-flash-1017" name="DeepSeek V4.1 Flash 1017" {
			reasoning #true
