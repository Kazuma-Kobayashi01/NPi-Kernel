			}
		}
	}
	// Aliases and dated snapshots the published list leaves out keep their reviewed contract.
	models "qwen-plus-latest" "qwen-plus-2025-04-28" "qwen-flash-2025-07-28" "qwen3.5-plus-2026-02-15" "qwen3.5-flash-2026-02-23" "qwen3.6-plus-2026-04-02" "qwen3.6-flash-2026-04-16" "qwen3.7-max-2026-05-20" "qwen3.7-max-2026-06-08" "qwen3.7-plus-2026-05-26" "qwen3.7-flash-2026-07-15" {
