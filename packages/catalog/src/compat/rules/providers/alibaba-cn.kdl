// Catalog entry for "alibaba-cn" (Alibaba Cloud DashScope pay-as-you-go).
// Model metadata and thinking support follow models.dev as shipped in OpenCode 2.2.5.
// The seed supplies names, limits, prices and image input for discovered ids;
// the `models` blocks declare which thinking control each id really has.

provider "alibaba-cn" {
	default-model "qwen-plus"
	env "DASHSCOPE_API_KEY" "QIANWEN_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Alibaba(China)"

	seed api="openai-completions" base-url="https://dashscope.aliyuncs.com/compatible-mode/v1" bundle="fallback" {
		model "deepseek-r1" name="DeepSeek R1" {
			reasoning #false
			input "text"
			cost input=0.574 output=2.294 cache-read=0 cache-write=0
			limits context=131072 max-tokens=16384
		}
		model "deepseek-r1-0528" name="DeepSeek R1 0528" {
