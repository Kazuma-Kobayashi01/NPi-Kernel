// Catalog entry for "alibaba-cn" (Alibaba Cloud DashScope pay-as-you-go).

provider "alibaba-cn" {
	default-model "qwen-plus"
	env "DASHSCOPE_API_KEY" "QIANWEN_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Alibaba(China)"

	// Model Studio's documented hybrid models have a binary switch, not an
	// effort ladder. Exact IDs avoid assigning capabilities to unknown SKUs.
	models "qwen-plus" "qwen-plus-latest" "qwen-plus-2025-04-28" "qwen-flash" "qwen-flash-2025-07-28" \
		"qwen3.5-plus" "qwen3.5-plus-2026-02-15" "qwen3.5-flash" "qwen3.5-flash-2026-02-23" \
		"qwen3.5-397b-a17b" "qwen3.5-122b-a10b" "qwen3.5-27b" "qwen3.5-35b-a3b" \
		"qwen3.6-plus" "qwen3.6-plus-2026-04-02" "qwen3.6-flash" "qwen3.6-flash-2026-04-16" \
		"qwen3.7-max" "qwen3.7-max-2026-05-20" "qwen3.7-max-2026-06-08" \
		"qwen3.7-plus" "qwen3.7-plus-2026-05-26" "qwen3.7-flash" "qwen3.7-flash-2026-07-15" {
		thinking-upgrade-neutral #true
		thinking-efforts "medium"
		thinking-requires-effort #false
		thinking-format "qwen"
	}
	models "qwen3.7-max-preview" "qwen3.7-max-2026-05-17" {
		thinking-upgrade-neutral #true
		thinking-efforts "medium"
		thinking-requires-effort #true
		thinking-format "qwen"
	}
	// These exact text models expose the documented native effort vocabulary.
	models "qwen3.8-max" "qwen3.8-max-0902" "qwen3.8-flash" "qwen3.8-27b" "qwen3.8-2.4t-a95b" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "medium" "xhigh"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "qwen3.8-2.4t-a95b" {
		thinking-requires-effort #true
	}
}
