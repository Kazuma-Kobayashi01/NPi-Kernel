		}
	}

	// A binary enable_thinking switch shows one level; effort models send
	// reasoning_effort with enable_thinking. Models that always think and take no control
	// (reasoning #false in the seed) send no thinking parameter at all.
	models "deepseek-v4-flash" {
		thinking-upgrade-neutral #true
		thinking-efforts "high" "max"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "deepseek-v4-pro" "glm-5.2" {
		thinking-upgrade-neutral #true
		thinking-efforts "high" "max"
		thinking-default-level "high"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
			thinking-format "openai"
			extra-body {
				enable_thinking #true
			}
		}
	}
	models "deepseek-v4-pro-0813" "deepseek-v4.1-flash" "deepseek-v4.1-flash-1017" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-default-level "high"
		thinking-format "qwen"
		supports-reasoning-effort #true
		when-thinking {
