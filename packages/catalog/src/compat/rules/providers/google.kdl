// Provider-wire compat for "google"; regenerated from the frozen census using deployment contract selectors.

provider "google" {
	default-model "gemini-3.1-pro-preview"
	env "GEMINI_API_KEY"
	kind-apis {
		image "google-generative-ai"
	}
	web-search "gemini"
	image-count-budget 200

	// Public GenerateContent supports the documented synchronous 64K output cap.
	// https://aistudio.google.com/docs/models/gemini-4-hydrogen
	// https://aistudio.google.com/docs/pricing#gemini-4-hydrogen
	seed api="google-generative-ai" base-url="https://generativelanguage.googleapis.com/v1beta" bundle="always" {
		model "gemini-4-hydrogen" name="Gemini 4 Hydrogen" {
			reasoning #true
			input "text" "image"
			cost input=1.5 output=7.5 cache-read=0.075 cache-write=0
			limits context=1048576 max-tokens=65536
		}
	}

	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*latest" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-2.5-computer-use-preview-10-2025" "gemini-robotics-er-1.6-preview" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// The proxy conservatively classifies tool-capable text+image output as chat;
	// this SKU is a native image generator on the Gemini image transport.
	models "gemini-3.1-flash-lite-image" {
		kind "image"
	}
}
